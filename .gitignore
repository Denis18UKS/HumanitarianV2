# Ghost Camaro FBX and textures generated by its verified binary-chunk bootstrap.
# Source/Parts/*.bin is tracked and is the authoritative copy of the original assets.
/Assets/Humanitarian/Vehicles/GhostCamaro/Models/*.fbx
/Assets/Humanitarian/Vehicles/GhostCamaro/Models/*.fbx.meta
/Assets/Humanitarian/Vehicles/GhostCamaro/Textures/*.png
/Assets/Humanitarian/Vehicles/GhostCamaro/Textures/*.png.meta
/Assets/Humanitarian/Vehicles/GhostCamaro/Materials/
/Assets/Humanitarian/Vehicles/GhostCamaro/Animations/*.controller
/Assets/Humanitarian/Vehicles/GhostCamaro/Animations/*.controller.meta
/Assets/Humanitarian/Vehicles/GhostCamaro/Prefabs/*.prefab
/Assets/Humanitarian/Vehicles/GhostCamaro/Prefabs/*.prefab.meta
/Assets/Humanitarian/Scenes/GhostCamaro_DrivingDemo.unity
/Assets/Humanitarian/Scenes/GhostCamaro_DrivingDemo.unity.meta
/Assets/Humanitarian/Vehicles/GhostCamaro/Source/Parts/*.bin.meta
